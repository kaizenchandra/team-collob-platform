# Local development only. Set in the shell or use a secret manager; never commit real secrets.
DATABASE_URL=postgres://concord:local-development-only@localhost:55432/concord
DEV_AUTH=true
WEB_ORIGIN=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:4100
PORT=4100
API_HOST=127.0.0.1
# Production: NODE_ENV=production, DEV_AUTH=false, HTTPS, provisioned OIDC subjects.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
FILE_ROOT=.data/files

# Optional local Keycloak: use compose.identity.yaml; these flags are rejected in production.
OIDC_LOCAL_HTTP=false
OIDC_REQUIRED_ACR=

# Enable provider-specific recovery actions only for a configured Keycloak deployment.
OIDC_PROVIDER=
# Explicit provider introspection/refresh; never enable without a durable server-only keyring.
OIDC_RECONCILE=false
OIDC_TOKEN_KEY_FILE=

# Optional object-storage promotion; all settings stay server-side. Prefer compose.storage.yaml locally.
# Leaving every S3 setting absent uses local-only storage; partially configured storage fails closed.
# S3_ENDPOINT=https://object-store.example.invalid
# S3_BUCKET=concord-files
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=INJECT_READER_FOR_API_OR_WRITER_FOR_WORKER
# S3_SECRET_ACCESS_KEY=INJECT_SECRET
# S3_ALLOW_INSECURE_LOCAL=false

# Optional SMTP digest worker. Local capture is configured by compose.email.yaml.
# Real SMTP requires implicit TLS, verified sender/domain, secret injection and HTTPS app URL.
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=notifications@example.invalid
# APP_PUBLIC_URL=https://collaboration.example.invalid
# SMTP_LOCAL_CAPTURE=false

# Optional conferencing: set all four values together; credentials stay on API/worker only.
# LIVEKIT_URL=wss://media.example.invalid
# LIVEKIT_API_URL=https://media.example.invalid
# LIVEKIT_API_KEY=INJECT_API_KEY
# LIVEKIT_API_SECRET=INJECT_SECRET_AT_LEAST_32_CHARACTERS
# LIVEKIT_ALLOW_INSECURE_LOCAL=false
# Run media-worker with the same DB, auth and LiveKit configuration as the API.
# Provider policy requires room.auto_create=false and a dedicated cc-UUID namespace.
# Configure signed provider webhooks to POST /v1/media/webhook.
# Optional lower deployment limits (upper bounds are product limits; local32-device synthetic audio probe is recorded; production/video capacity remains unverified).
# MEDIA_PARTICIPANT_LIMIT=32
# MEDIA_INVITATION_LIMIT=100
# MEDIA_ACTIVE_CALL_LIMIT=32
