# Required production values, provided through the target's secret manager.
NODE_ENV=production
DEV_AUTH=false
DATABASE_URL=postgres://app:INJECT_SECRET@postgres.internal:5432/concord?sslmode=verify-full
WEB_ORIGIN=https://collaboration.example.invalid
NEXT_PUBLIC_API_URL=https://collaboration.example.invalid
OIDC_ISSUER=https://identity.example.invalid/realms/company
OIDC_CLIENT_ID=concord
OIDC_CLIENT_SECRET=INJECT_SECRET
OIDC_REDIRECT_URI=https://collaboration.example.invalid/v1/auth/callback
# Set to the exact provider-defined ACR that proves your enforced MFA policy; never assume a number means MFA.
OIDC_REQUIRED_ACR=INJECT_VERIFIED_PROVIDER_MFA_ACR
# Set only after verifying the Keycloak recovery flow; omit for other providers.
OIDC_PROVIDER=keycloak
OIDC_RECONCILE=true
OIDC_TOKEN_KEY_FILE=/run/secrets/identity-token-keys.json
# Local HTTP flags must be absent/false in production.
# Production release is blocked until provider/storage/security/HA gates pass.

# Object storage: deployment remains unverified. Inject separate API read and worker write identities.
S3_ENDPOINT=https://object-store.example.invalid
S3_BUCKET=concord-files
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=INJECT_SCOPED_IDENTITY
S3_SECRET_ACCESS_KEY=INJECT_SECRET
S3_ALLOW_INSECURE_LOCAL=false
# Required: encrypted provider storage, TLS, network policy, rotation and coordinated backup/restore.
# The current upload spool still requires persistent/shared FILE_ROOT and does not support stateless upload nodes.

# Email delivery remains unconfigured until provider/domain credentials are supplied.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_PUBLIC_URL=https://collaboration.example.invalid
SMTP_LOCAL_CAPTURE=false
